<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_pdf_design_profile_company" model="ir.rule">
        <field name="name">PDF Design: multi-company</field>
        <field name="model_id" ref="model_pdf_design_profile"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_pdf_design_font_rule_company" model="ir.rule">
        <field name="name">PDF Font Rule: multi-company</field>
        <field name="model_id" ref="model_pdf_design_font_rule"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
